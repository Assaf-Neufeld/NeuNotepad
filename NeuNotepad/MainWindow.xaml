<Window x:Class="NeuNotepad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:converters="clr-namespace:NeuNotepad.Converters"
        Title="NeuNotepad" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Icon="Assets/app.ico">
    
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}" />
        <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding FormatJsonCommand}" />
    </Window.InputBindings>
    
    <Window.Resources>
        <!-- Converters -->
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        
        <!-- Color Palette -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#4682B4"/>
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#36648B"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF6B35"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#666666"/>
        
        <!-- Menu Style -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryDarkColor}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Toolbar Style -->
        <Style TargetType="ToolBar">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        
        <!-- Toolbar Button Style -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- JSON Button Style (Accent) -->
        <Style x:Key="JsonButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E55A2B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CC4F25"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Tab Close Button -->
        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="9">
                            <TextBlock Text="×" FontSize="14" FontWeight="Bold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                       Foreground="#888" Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Tab AI Generate Button -->
        <Style x:Key="TabAIButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Generate AI title"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="9">
                            <TextBlock Text="✨" FontSize="11" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                       Margin="0,-1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E8F4FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        
        <!-- TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,4,0,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceColor}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1,2,1,0"/>
                                <Setter TargetName="border" Property="Margin" Value="2,2,0,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8F8F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- StatusBar Style -->
        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        
        <Style TargetType="StatusBarItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewCommand}"/>
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{Binding OpenCommand}"/>
                <Separator/>
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"/>
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="_Close Tab" InputGestureText="Ctrl+W" Command="{Binding CloseTabCommand}"/>
                <MenuItem Header="Close _All Tabs" Command="{Binding CloseAllTabsCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}"/>
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}"/>
                <Separator/>
                <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Command="{Binding CutCommand}"/>
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}"/>
                <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}"/>
                <Separator/>
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}"/>
            </MenuItem>
            <MenuItem Header="_JSON">
                <MenuItem Header="_Format JSON" Command="{Binding FormatJsonCommand}"/>
                <Separator/>
                <MenuItem Header="_Enable JSON Highlighting" Click="EnableJsonHighlighting_Click"/>
            </MenuItem>
            <MenuItem Header="_AI">
                <MenuItem Header="_Enable Smart Titles" 
                          IsCheckable="True" 
                          IsChecked="{Binding SmartTitlesEnabled, Mode=OneWay}"
                          Command="{Binding ToggleSmartTitlesCommand}"/>
                <MenuItem Header="_Generate Title Now" Command="{Binding GenerateTitleNowCommand}"/>
                <Separator/>
                <MenuItem Header="_Configure Model Path..." Command="{Binding ConfigureAICommand}"/>
            </MenuItem>
        </Menu>
        
        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceColor}" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding NewCommand}" ToolTip="New (Ctrl+N)" Content="New"/>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenCommand}" ToolTip="Open (Ctrl+O)" Content="Open"/>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)" Content="Save"/>
                <Rectangle Width="1" Fill="#E0E0E0" Margin="8,0"/>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" Content="Undo"/>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" Content="Redo"/>
                <Rectangle Width="1" Fill="#E0E0E0" Margin="8,0"/>
                <Button Style="{StaticResource JsonButton}" Command="{Binding FormatJsonCommand}" ToolTip="Format JSON" Content="Format JSON"/>
                <Rectangle Width="1" Fill="#E0E0E0" Margin="8,0"/>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding CloseTabCommand}" ToolTip="Close Tab (Ctrl+W)" Content="Close Tab"/>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding CloseAllTabsCommand}" ToolTip="Close All Tabs" Content="Close All"/>
            </StackPanel>
        </Border>
        
        <!-- Tab Control -->
        <TabControl x:Name="TabControl" Grid.Row="2" SelectionChanged="TabControl_SelectionChanged" MouseDoubleClick="TabControl_MouseDoubleClick">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Header}" VerticalAlignment="Center" FontSize="13"/>
                        <Button Style="{StaticResource TabAIButton}" 
                                Click="GenerateTitle_Click" 
                                Tag="{Binding}"
                                Visibility="{Binding HasBeenSaved, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <Button Style="{StaticResource TabCloseButton}" 
                                Click="CloseTab_Click" 
                                Tag="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SurfaceColor}" CornerRadius="0,0,4,4">
                        <avalonedit:TextEditor x:Name="Editor"
                                               FontFamily="Consolas"
                                               FontSize="14"
                                               ShowLineNumbers="True"
                                               WordWrap="True"
                                               Document="{Binding Document}"
                                               Loaded="Editor_Loaded"
                                               Background="{StaticResource SurfaceColor}"
                                               Padding="4"/>
                    </Border>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12"/>
            </StatusBarItem>
            <Separator Background="#5A8FC4"/>
            <StatusBarItem>
                <TextBlock x:Name="EncodingText" Text="UTF-8" FontSize="12"/>
            </StatusBarItem>
            <Separator Background="#5A8FC4"/>
            <StatusBarItem>
                <TextBlock x:Name="LineColumnText" Text="Ln 1, Col 1" FontSize="12"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
