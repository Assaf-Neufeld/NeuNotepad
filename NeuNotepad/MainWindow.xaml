<Window x:Class="NeuNotepad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:converters="clr-namespace:NeuNotepad.Converters"
        Title="NeuNotepad" Height="700" Width="1000"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Icon="Assets/app.ico">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}" />
        <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding FormatJsonCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <Color x:Key="InkColor">#18222F</Color>
        <Color x:Key="MutedInkColor">#5B6673</Color>
        <Color x:Key="LineColor">#DDE4EA</Color>
        <Color x:Key="ChromeColor">#EEF3F6</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="SurfaceRaisedColor">#FAFCFD</Color>
        <Color x:Key="PrimaryColor">#2F6F73</Color>
        <Color x:Key="PrimaryHoverColor">#255B5F</Color>
        <Color x:Key="PrimaryPressedColor">#1E4B4F</Color>
        <Color x:Key="AccentColor">#F36B3B</Color>
        <Color x:Key="AccentHoverColor">#DC5930</Color>
        <Color x:Key="AccentPressedColor">#C64C29</Color>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource ChromeColor}"/>
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>
        <SolidColorBrush x:Key="MutedInkBrush" Color="{StaticResource MutedInkColor}"/>
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>

        <DropShadowEffect x:Key="SoftShadow" BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.10" Color="#203040"/>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="#243238"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#34454C"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                    <Setter Property="Padding" Value="14,8"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                    <Setter Property="Padding" Value="14,8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E9F0F2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#D7E2E6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DDE9EC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryCommandButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommandIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CommandLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolbarSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Fill" Value="{StaticResource LineBrush}"/>
            <Setter Property="Margin" Value="8,0,12,0"/>
        </Style>

        <Style x:Key="TabGlyphButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5ECEF"/>
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D7E2E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource TabGlyphButton}">
            <Setter Property="ToolTip" Value="Close tab"/>
        </Style>

        <Style x:Key="TabAIButton" TargetType="Button" BasedOn="{StaticResource TabGlyphButton}">
            <Setter Property="ToolTip" Value="Generate AI title"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#E7EEF1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7,7,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F7F8"/>
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="#243238"/>
            <Setter Property="Foreground" Value="#ECF4F5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>

        <Style TargetType="StatusBarItem">
            <Setter Property="Foreground" Value="#ECF4F5"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewCommand}"/>
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{Binding OpenCommand}"/>
                <Separator/>
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"/>
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="_Close Tab" InputGestureText="Ctrl+W" Command="{Binding CloseTabCommand}"/>
                <MenuItem Header="Close _All Tabs" Command="{Binding CloseAllTabsCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}"/>
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}"/>
                <Separator/>
                <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Command="{Binding CutCommand}"/>
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}"/>
                <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}"/>
                <Separator/>
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}"/>
            </MenuItem>
            <MenuItem Header="_JSON">
                <MenuItem Header="_Format JSON" Command="{Binding FormatJsonCommand}"/>
                <Separator/>
                <MenuItem Header="_Enable JSON Highlighting" Click="EnableJsonHighlighting_Click"/>
            </MenuItem>
            <MenuItem Header="_AI">
                <MenuItem Header="_Enable Smart Titles"
                          IsCheckable="True"
                          IsChecked="{Binding SmartTitlesEnabled, Mode=OneWay}"
                          Command="{Binding ToggleSmartTitlesCommand}"/>
                <MenuItem Header="_Generate Title Now" Command="{Binding GenerateTitleNowCommand}"/>
                <Separator/>
                <MenuItem Header="_Configure Model Path..." Command="{Binding ConfigureAICommand}"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,9">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource CommandButton}" Command="{Binding NewCommand}" ToolTip="New (Ctrl+N)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE710;"/>
                            <TextBlock Style="{StaticResource CommandLabel}" Text="New"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Command="{Binding OpenCommand}" ToolTip="Open (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE8E5;"/>
                            <TextBlock Style="{StaticResource CommandLabel}" Text="Open"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE74E;"/>
                            <TextBlock Style="{StaticResource CommandLabel}" Text="Save"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource ToolbarSeparator}"/>
                    <Button Style="{StaticResource CommandButton}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE7A7;"/>
                            <TextBlock Style="{StaticResource CommandLabel}" Text="Undo"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE7A6;"/>
                            <TextBlock Style="{StaticResource CommandLabel}" Text="Redo"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource ToolbarSeparator}"/>
                    <Button Style="{StaticResource PrimaryCommandButton}" Command="{Binding FormatJsonCommand}" ToolTip="Format JSON (Ctrl+Shift+F)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE8D2;"/>
                            <TextBlock Style="{StaticResource CommandLabel}" Text="Format JSON"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource CommandButton}" Command="{Binding CloseTabCommand}" ToolTip="Close Tab (Ctrl+W)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE711;"/>
                            <TextBlock Style="{StaticResource CommandLabel}" Text="Close Tab"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Command="{Binding CloseAllTabsCommand}" ToolTip="Close All Tabs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE8BB;"/>
                            <TextBlock Style="{StaticResource CommandLabel}" Text="Close All"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Background="{StaticResource AppBackgroundBrush}" Margin="0">
            <Border Margin="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Effect="{StaticResource SoftShadow}">
                <TabControl x:Name="TabControl" SelectionChanged="TabControl_SelectionChanged" MouseDoubleClick="TabControl_MouseDoubleClick" Padding="8,8,8,0">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" MinWidth="0">
                                <TextBlock Text="{Binding Header}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                                <Button Style="{StaticResource TabAIButton}"
                                        Click="GenerateTitle_Click"
                                        Tag="{Binding}"
                                        Visibility="{Binding HasBeenSaved, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE945;"/>
                                </Button>
                                <Button Style="{StaticResource TabCloseButton}"
                                        Click="CloseTab_Click"
                                        Tag="{Binding}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE711;"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                                <avalonedit:TextEditor x:Name="Editor"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="14"
                                                       ShowLineNumbers="True"
                                                       LineNumbersForeground="#93A0AA"
                                                       WordWrap="True"
                                                       Document="{Binding Document}"
                                                       Loaded="Editor_Loaded"
                                                       Background="{StaticResource SurfaceBrush}"
                                                       Foreground="{StaticResource InkBrush}"
                                                       Padding="10"
                                                       HorizontalScrollBarVisibility="Auto"
                                                       VerticalScrollBarVisibility="Auto"/>
                            </Border>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Border>
        </Grid>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="EncodingText" Text="UTF-8" Margin="0,0,18,0"/>
                    <TextBlock x:Name="LineColumnText" Text="Ln 1, Col 1"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
